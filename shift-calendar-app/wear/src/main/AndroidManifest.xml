<?xml version="1.0" encoding="utf-8"?>
<!-- [SHFT-08][REL-09] 밤낮 for Wear OS: no internet, no location. Everything comes from the phone app over the Data Layer. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- A restart drops the midnight alarm; ClockReceiver sets it again. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- [WEAR-06] 1.31: the phone's alarm shown and felt on the watch while it rings. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 2.0.0 [RVI-90] 워치 예비 알람: a minute after the phone's alarm, on time in the night (the phone app holds the same). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 1.39.1 [WEAR-07]: the watch shows no ads and reads no advertising ID; the line only matches the Play 광고 ID 선언 of the
         phone + watch release (1.39.0 had to be sent '권한 없이 출시' because the watch bundle lacked it). -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Needs the phone app: the days come from it. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 오늘·내일 근무와 다음 알람 타일. -->
        <service
            android:name=".ShiftTileService"
            android:exported="true"
            android:label="@string/tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

        <!-- 시계 화면에 놓는 오늘 근무. -->
        <service
            android:name=".TodayComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_launcher_monochrome"
            android:label="@string/complication_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <!-- [WEAR-03] 이번 주 근무시간: a ring toward 주 52시간. -->
        <service
            android:name=".WeekHoursComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_launcher_monochrome"
            android:label="@string/week_complication_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE,SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <!-- 1.32 [WEAR-04] 다음 근무까지 (근무 중이면 끝까지). -->
        <service
            android:name=".NextShiftComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_launcher_monochrome"
            android:label="@string/next_complication_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <!-- The phone's days arriving; only Google Play services binds it. -->
        <service
            android:name=".DaysListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:path="/bamnat/days"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- [WEAR-06] The phone's alarm ringing and stopping. -->
        <service
            android:name=".RingListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/bamnat/ring"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <receiver
            android:name=".RingActionReceiver"
            android:exported="false" />

        <!-- 2.0.0 [RVI-90] The watch's own alarm a minute after the phone's. -->
        <receiver
            android:name=".BackupRingReceiver"
            android:exported="false" />

        <activity
            android:name=".RingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:turnScreenOn="true" />

        <!-- Midnight: the tile and complication move on to the new day. -->
        <receiver
            android:name=".MidnightReceiver"
            android:exported="false" />

        <!-- A restart, a new time or a new time zone: draw again and set the midnight alarm anew. -->
        <receiver
            android:name=".ClockReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
