<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below: Google auto backup [REL-04].
     Keeps the schedule database and settings; leaves out what only makes sense on this phone (alarm_state.xml is simply not included). -->
<!-- [REL-15] Receipt photos stay out, as in data_extraction_rules.xml. -->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="sharedpref" path="settings.xml" />
    <include domain="file" path="." />
    <exclude domain="file" path="diag/" />
    <exclude domain="file" path="receipts/" />
    <!-- [SLEEP-07] 1.38 잠 소리 클립은 이 휴대폰에만(7일 뒤 지움), 클라우드로 올리지 않아요. -->
    <exclude domain="file" path="sleep_clips/" />
    <!-- [MPH-03] 1.38 메모 사진도 영수증처럼 클라우드 백업에서 빼요(25MB 한도). -->
    <exclude domain="file" path="memo-photos/" />
    <!-- [MAT-05] 1.36 받은 공개 글꼴은 다시 받으면 돼요(본명조 14MB, 자동 백업 25MB 한도를 아껴요). -->
    <exclude domain="file" path="fonts/open/" />
    <!-- 2.0.0 [RVP-73] (검토 REST-15) 내 글꼴도 빼요(25MB 한도를 넘으면 근무표 DB까지 못 올라가요). -->
    <exclude domain="file" path="fonts/" />
</full-backup-content>
