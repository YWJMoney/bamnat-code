@@ -0,0 +1,42 @@
+package com.bamnat.app.alarm
+
+import androidx.test.core.app.ApplicationProvider
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import com.bamnat.app.NoticeLinks
+import com.bamnat.app.inbox.Inbox
+import com.bamnat.app.inbox.InboxSection
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+
+/**
+ * 2.0.0 [RVIB-24] (HQ-106) 배터리 절약 안내: one row in the 알림함's 안내 (not the band), only while alarms are on and one is coming and
+ * the phone saves battery on 밤낮, told once; a tap opens 알람 점검.
+ */
+@RunWith(AndroidJUnit4::class)
+class BatteryNoteTest {
+    @Test fun dueOnlyWhenAnAlarmCouldBeLate() {
+        assertTrue(BatteryNote.due(alarmsOn = true, alarmComing = true, unrestricted = false, told = false))
+        assertFalse("battery use left unrestricted", BatteryNote.due(true, true, unrestricted = true, told = false))
+        assertFalse("nothing to ring", BatteryNote.due(true, alarmComing = false, unrestricted = false, told = false))
+        assertFalse("alarms off", BatteryNote.due(alarmsOn = false, alarmComing = true, unrestricted = false, told = false))
+        assertFalse("told before", BatteryNote.due(true, true, false, told = true))
+    }
+
+    @Test fun theRowIsANoticeThatOpensTheAlarmCheck() {
+        val row = BatteryNote.row()
+        assertEquals(InboxSection.NOTICE, row.section)
+        assertEquals(NoticeLinks.Target.ALARM_CHECK, row.target)
+        assertEquals("배터리 절약 때문에 알람이 늦게 울릴 수 있어요", row.title)
+        assertEquals(BatteryNote.KIND, row.kind)
+    }
+
+    @Test fun anUnrestrictedPhoneGetsNoRow() = runBlocking {
+        val context = ApplicationProvider.getApplicationContext<android.content.Context>()
+        BatteryNote.maybePost(context, unrestricted = true)
+        assertFalse(Inbox.get(context).rows.value.any { it.kind == BatteryNote.KIND })
+    }
+}
