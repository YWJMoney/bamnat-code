+package com.bamnat.app.ui.calendar
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+/** 2.0.0 [HQ-128] The card's rest warning is the line alone; the limit it was told by goes to ⓘ. */
+class RestSaidTest {
+    @Test fun theLimitLeavesTheLine() {
+        val (line, note) = restSaid("내일 · 10/9부터 7일째 쉬는 날 없이 근무 (7일째부터 알려요 · 기본)")
+        assertEquals("내일 · 10/9부터 7일째 쉬는 날 없이 근무", line)
+        assertEquals("7일째부터 알려요 · 기본", note)
+        val (l2, n2) = restSaid("야간이 끝난 12/3 뒤 쉬는 날 1일 (2일보다 적으면 알려요)")
+        assertEquals("야간이 끝난 12/3 뒤 쉬는 날 1일", l2)
+        assertEquals("2일보다 적으면 알려요", n2)
+    }
+
+    @Test fun aLineWithoutALimitStaysWhole() {
+        val said = "근무 사이가 9시간이에요 (11시간보다 짧아요)"
+        assertEquals(said to null, restSaid(said))
+        assertNull(restSaid("쉬는 날이 없어요").second)
+    }
+}
