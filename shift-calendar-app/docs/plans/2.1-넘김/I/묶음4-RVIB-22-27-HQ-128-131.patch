diff --git a/shift-calendar-app/app/src/main/java/com/bamnat/app/sleep/NapStart.kt b/shift-calendar-app/app/src/main/java/com/bamnat/app/sleep/NapStart.kt
new file mode 100644
index 000000000..bb93fc199
--- /dev/null
+++ b/shift-calendar-app/app/src/main/java/com/bamnat/app/sleep/NapStart.kt
@@ -0,0 +1,57 @@
+package com.bamnat.app.sleep
+
+import com.bamnat.app.AppContainer
+import com.bamnat.app.ui.Fmt
+import com.bamnat.core.alarm.AlarmPlanner
+import com.bamnat.core.sleep.NapAlarm
+import com.bamnat.core.time.Today
+import kotlinx.coroutines.flow.first
+import java.time.LocalDateTime
+
+/**
+ * 1.38 [SLEEP-23] 낮잠 자기: 잠들었어요 now, and the wake at a time with the day's alarms ([NapAlarm]), so it rings like a work alarm.
+ * One undo takes back both. 2.0.0 [RVIB-27] (PC-171) The same from two places: 오늘의 흐름's '낮잠 자기' (its own time) and the sleep
+ * page's '낮잠' (20·30·60·90분), so both ring, say and undo alike.
+ */
+object NapStart {
+    class Started(val message: String, val undo: suspend () -> Unit)
+
+    suspend fun start(container: AppContainer, until: LocalDateTime): Started {
+        val schedule = container.calendars.activeRepository()
+        val calendar = container.calendars.active.value
+        val asleep = container.sleepRepository.fellAsleep()
+        val date = until.toLocalDate()
+        val ringing = container.settingsRepository.current.alarmsEnabled
+        val resolver = schedule.snapshot.first().resolver
+        val dayAlarms = AlarmPlanner.alarmsOn(resolver, date).map { it.triggerAt }
+        val merged = if (!ringing) null else NapAlarm.merge(date, dayAlarms, until)
+        val before = merged?.let { schedule.setDayAlarms(date, it) }
+        // 2.0.0 [RVI-17] (검토 ALM-08) Kept so it rings as 낮잠 알람 and an early 깼어요 takes it back out.
+        if (merged != null) NapWake.save(container.appContext, date,
+            until.atZone(Today.zone()).toInstant().toEpochMilli(), hadOwn = resolver.resolve(date).entry?.customAlarms != null, calendar, merged)
+        val at = Fmt.time(until.toLocalTime())
+        // 2.0.0 [RVI-40] (검토 ALM-25) An alarm already near the wake is the one that wakes: said so, not "○시에 깨워요".
+        val near = if (ringing && merged == null) NapAlarm.near(dayAlarms, until) else null
+        val message = when {
+            !ringing -> "낮잠 자는 중이에요 · 근무 알람이 꺼져 있어서 ${at}에 깨우지 않아요"
+            near != null -> "낮잠 자는 중이에요 · ${Fmt.time(near.toLocalTime())}쯤 울리는 알람이 있어 그걸로 깨워요"
+            else -> "낮잠 자는 중이에요 · ${at}에 깨워요"
+        }
+        return Started(message) {
+            if (merged != null) NapWake.clear(container.appContext) // first, so the undo puts the day back itself
+            if (asleep.started) container.sleepRepository.delete(asleep.entry.id)
+            // 2.0.0 [RVI-17] A day with nothing saved before (null) is put back too: the wake stayed after 되돌리기.
+            if (merged != null) schedule.restoreDay(date, before)
+        }
+    }
+
+    /**
+     * 2.0.0 [RVIB-27] (PC-171) The sleep page's '낮잠' choices: [minutes] from [now], or the next alarm when it comes first (a nap
+     * never runs past the alarm that wakes for work).
+     */
+    suspend fun wakeFor(container: AppContainer, now: LocalDateTime, minutes: Int): LocalDateTime {
+        val next = if (!container.settingsRepository.current.alarmsEnabled) null
+            else AlarmPlanner.nextAlarm(container.calendars.activeRepository().snapshot.first().resolver, now)?.triggerAt
+        return NapAlarm.wakeFor(now, minutes, next)
+    }
+}
