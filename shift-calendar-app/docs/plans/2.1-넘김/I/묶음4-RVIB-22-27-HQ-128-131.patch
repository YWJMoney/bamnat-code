@@ -0,0 +1,38 @@
+package com.bamnat.core
+
+import com.bamnat.core.sleep.NapAlarm
+import com.bamnat.core.work.TypeWords
+import com.bamnat.core.work.WorkStyle
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.time.LocalDateTime
+
+/** 2.0.0 [RVIB-27] (PC-171) The sleep page's '낮잠' and [RVIB-26] (PC-165) a 현장's words on the notice pages. */
+class NapChoiceTest {
+    private val now = LocalDateTime.of(2026, 11, 18, 14, 0)
+
+    @Test fun theChoices() = assertEquals(listOf(20, 30, 60, 90), NapAlarm.CHOICES)
+
+    @Test fun aNapWakesAfterItsLength() {
+        assertEquals(now.plusMinutes(30), NapAlarm.wakeFor(now, 30, null))
+        assertEquals(now.plusMinutes(90), NapAlarm.wakeFor(now, 90, now.plusHours(3)))
+    }
+
+    @Test fun theNextAlarmCutsItShort() {
+        val alarm = now.plusMinutes(45)
+        assertEquals(alarm, NapAlarm.wakeFor(now, 60, alarm))
+        assertEquals(now.plusMinutes(20), NapAlarm.wakeFor(now, 20, alarm))
+        // An alarm already past is not the one that wakes.
+        assertEquals(now.plusMinutes(20), NapAlarm.wakeFor(now, 20, now.minusMinutes(5)))
+    }
+
+    @Test fun aFieldWorkersDayEndsAsAnIlJeong() {
+        assertEquals("일 끝난 뒤 가계부 정리 알림", TypeWords.say(WorkStyle.FIELD, "퇴근 뒤 가계부 정리 알림"))
+        assertEquals("일이 끝나고 30분 뒤", TypeWords.say(WorkStyle.FIELD, "근무가 끝나고 30분 뒤"))
+        assertEquals("일 끝 30분 뒤 오늘 쓴 돈", TypeWords.say(WorkStyle.FIELD, "근무 끝 30분 뒤 오늘 쓴 돈"))
+        assertTrue(TypeWords.leaks(WorkStyle.DAY, "일감 시작 전 알림은 일감마다 정해요.").isNotEmpty())
+        assertTrue(TypeWords.leaks(WorkStyle.FIELD, "일감 시작 전 알림은 일감마다 정해요.").isEmpty())
+        assertTrue(TypeWords.leaks(null, "근무가 끝나고").isEmpty())
+    }
+}
