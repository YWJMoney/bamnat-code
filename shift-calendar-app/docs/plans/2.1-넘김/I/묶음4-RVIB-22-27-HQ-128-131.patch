diff --git a/shift-calendar-app/app/src/main/java/com/bamnat/app/alarm/BatteryNote.kt b/shift-calendar-app/app/src/main/java/com/bamnat/app/alarm/BatteryNote.kt
new file mode 100644
index 000000000..c6d8e7443
--- /dev/null
+++ b/shift-calendar-app/app/src/main/java/com/bamnat/app/alarm/BatteryNote.kt
@@ -0,0 +1,49 @@
+package com.bamnat.app.alarm
+
+import android.content.Context
+import android.os.PowerManager
+import com.bamnat.app.NoticeLinks
+import com.bamnat.app.appContainer
+import com.bamnat.app.inbox.Inbox
+import com.bamnat.app.inbox.InboxRow
+import com.bamnat.app.inbox.InboxSection
+import com.bamnat.core.alarm.AlarmPlanner
+import com.bamnat.core.time.Today
+import kotlinx.coroutines.flow.first
+
+/**
+ * 2.0.0 [RVIB-24] (HQ-106) 배터리 절약: a phone that keeps 밤낮 under battery saving may ring the alarm some minutes late. It never stops
+ * the alarm, so it is not for the band over the calendar (only what keeps an alarm from ringing goes there, [AlarmGuard]); before, it
+ * was only in 설정 › 알람 and 알람 점검, where nobody looks until an alarm was late. Now one row in the 알림함's 안내, once on this
+ * phone, while alarms are on and one is coming: a tap opens 알람 점검 (where 배터리 최적화 제외 is set), the row's X takes it away and
+ * '다시 보지 않기' turns the kind off. Told once even when the kind was turned off, so it never comes back by itself.
+ */
+object BatteryNote {
+    const val KIND = "alarm.battery"
+    internal const val PREFS = "battery_note"
+    private const val K_TOLD = "told"
+
+    const val TITLE = "배터리 절약 때문에 알람이 늦게 울릴 수 있어요"
+    const val LINE = "눌러서 알람 점검을 열고 배터리 사용을 ‘제한 없음’으로 두면 제때 울려요"
+
+    /** Whether the row is due: alarms on, one coming, the phone saving battery on 밤낮, and not told before. */
+    fun due(alarmsOn: Boolean, alarmComing: Boolean, unrestricted: Boolean, told: Boolean): Boolean =
+        alarmsOn && alarmComing && !unrestricted && !told
+
+    fun row(): InboxRow = InboxRow(key = KIND, kind = KIND, section = InboxSection.NOTICE, title = TITLE, line = LINE,
+        target = NoticeLinks.Target.ALARM_CHECK)
+
+    /** Puts the row in once when [due]; [unrestricted] is read from the phone unless given (tests). */
+    suspend fun maybePost(context: Context, unrestricted: Boolean? = null) {
+        val prefs = context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        if (prefs.getBoolean(K_TOLD, false)) return
+        val c = context.appContainer
+        val alarmsOn = c.settingsRepository.current.alarmsEnabled
+        val free = unrestricted ?: (context.getSystemService(PowerManager::class.java)?.isIgnoringBatteryOptimizations(context.packageName) ?: true)
+        if (!alarmsOn || free) return
+        val coming = AlarmPlanner.nextAlarm(c.scheduleRepository.snapshot.first().resolver, Today.dateTime()) != null
+        if (!due(alarmsOn, coming, free, told = false)) return
+        Inbox.post(context, row())
+        prefs.edit().putBoolean(K_TOLD, true).apply()
+    }
+}
