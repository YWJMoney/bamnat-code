 object NapAlarm {
     const val NEAR_MINUTES = 10L
 
+    /** 2.0.0 [RVIB-27] (PC-171) How long the sleep page's '낮잠' may be, in minutes. */
+    val CHOICES = listOf(20, 30, 60, 90)
+
+    /** The wake [minutes] after [now], or [nextAlarm] when that comes first: a nap never runs past the alarm that wakes for work. */
+    fun wakeFor(now: LocalDateTime, minutes: Int, nextAlarm: LocalDateTime?): LocalDateTime {
+        val wake = now.plusMinutes(minutes.toLong())
+        return if (nextAlarm != null && nextAlarm.isAfter(now) && nextAlarm.isBefore(wake)) nextAlarm else wake
+    }
+
     fun merge(date: LocalDate, dayAlarms: List<LocalDateTime>, wake: LocalDateTime): List<DayAlarm>? {
         if (near(dayAlarms, wake) != null) return null
         return (dayAlarms + wake).mapNotNull { DayAlarm.ringingAt(date, it) }
