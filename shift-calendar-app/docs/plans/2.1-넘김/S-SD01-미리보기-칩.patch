+package com.bamnat.core.recipe
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+/**
+ * 2.0.0 [RVS-01] 검토 SD-01 '옛 판': what an older phone draws of a work leaves out the parts it does not read yet, nothing else.
+ */
+class AsSeenByTest {
+    private fun work(vararg lines: Map<String, Any?>) = Recipe("옛 판", styles = com.bamnat.core.work.WorkStyle.entries.toSet(),
+        pieces = listOf(Piece(PieceKind.PARTS, mapOf("parts" to lines.toList()))))
+
+    @Suppress("UNCHECKED_CAST")
+    private fun ids(r: Recipe) = (r.pieces.first().values["parts"] as List<Map<String, Any?>>).map { it["id"] }
+
+    @Test fun anOlderPhoneLeavesOutWhatItDoesNotRead() {
+        val w = work(mapOf("id" to "cal.cell", "fill" to 0xFFE0F2F1L), mapOf("id" to "night.clock", "size" to 40L), mapOf("id" to "memo.page", "fill" to 0xFFFFFFFFL))
+        // 1.38.0 (52) reads 메모 종이 but not the 밤 화면 (53).
+        assertEquals(listOf<Any?>("cal.cell", "memo.page"), ids(RecipeNeeds.asSeenBy(w, 52)))
+        // 1.36.1 (50) reads neither.
+        assertEquals(listOf<Any?>("cal.cell"), ids(RecipeNeeds.asSeenBy(w, 50)))
+        // 1.39.0 (53) and later read all of it.
+        assertEquals(ids(w), ids(RecipeNeeds.asSeenBy(w, 53)))
+    }
+
+    @Test fun aStateAnOlderPhoneDoesNotReadTakesItsLineOut() {
+        val w = work(mapOf("id" to "pay.row", "fill" to 0xFFFFFFFFL), mapOf("id" to "pay.row", "on" to "late", "fill" to 0xFFFFCDD2L))
+        val seen = RecipeNeeds.asSeenBy(w, 52)
+        assertEquals(1, (seen.pieces.first().values["parts"] as List<*>).size)
+        // The recipe itself is not changed.
+        assertEquals(2, (w.pieces.first().values["parts"] as List<*>).size)
+    }
+
+    @Test fun aWorkWithoutPartsIsLeftAlone() {
+        val w = Recipe("무", styles = com.bamnat.core.work.WorkStyle.entries.toSet(), pieces = emptyList())
+        assertEquals(w, RecipeNeeds.asSeenBy(w, 50))
+    }
+}
