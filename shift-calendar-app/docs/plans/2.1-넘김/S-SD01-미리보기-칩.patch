+package com.bamnat.app.screenshots
+
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.annotation.Config
+import org.robolectric.annotation.GraphicsMode
+
+/**
+ * 2.0.0 갈래 S 5묶음의 사진 (디자인 품질 조건 12·14, `build/screenshots/s5/`): 스튜디오 미리 보기 = 실제 (검토 SD-01) 등.
+ * Each screen in the four looks that see every pair of 밝은·어두운 × 글자 100·200% × 접은·편 폭 once.
+ */
+@RunWith(AndroidJUnit4::class)
+@GraphicsMode(GraphicsMode.Mode.NATIVE)
+@Config(sdk = [35])
+class S5ScreenshotTest : ScreenshotBase() {
+    private val looks = listOf(
+        Triple(false, 1f, FOLDED), Triple(true, 2f, FOLDED), Triple(false, 2f, UNFOLDED), Triple(true, 1f, UNFOLDED),
+    )
+
+    private fun night(q: String) = q.replace("-port-", "-port-night-")
+    private fun lookName(dark: Boolean, font: Float, q: String) =
+        "${if (dark) "dark" else "light"}_${(font * 100).toInt()}_${if (q == FOLDED) "folded" else "unfolded"}"
+
+    private fun fourLooks(name: String, what: ScreenshotBase.Screen.() -> String?) {
+        val misses = ArrayList<String>()
+        for ((dark, font, q) in looks) {
+            val n = "s5/${name}_${lookName(dark, font, q)}"
+            shoot(n, if (dark) night(q) else q, font) { what()?.let { misses += "$n: $it" } }
+        }
+        assertTrue(misses.joinToString("\n"), misses.isEmpty())
+    }
+
+    /** SD-01: the example's conditions — 움직임 끔, 옛 판 폰 — are chips like the others, and 진짜 화면으로 보기 says so when the draft changes nothing. */
+    @Test fun theStudioShowsWhatAnotherPhoneShows() = fourLooks("sd01_conditions") {
+        tapText("도구")
+        tapText("카드 배치", exact = true)
+        settle()
+        // The folded line opens over the example and shuts again after a pick: open it for each chip.
+        for (chip in listOf("움직임 끔", "옛 판 폰", "진짜 화면으로 보기")) {
+            runCatching { tapText("화면 줄 모두 펼쳐 보기", exact = true, scrolls = 0) }
+            settle()
+            tapText(chip, exact = true)
+            settle()
+        }
+        // The draft is on the real app (the band says so, and 입기 is not offered: the work is not made yet); 끝내기 comes back to the studio.
+        val onReal = appears("실제 화면이에요", ms = 8_000)
+        val offersWear = shows("입기", exact = true)
+        if (onReal && !offersWear) tapText("끝내기", exact = true)
+        settle()
+        when {
+            !onReal -> "the real app did not open"
+            offersWear -> "입기 is offered on a studio trial"
+            !appears("스튜디오", exact = true, ms = 8_000) -> "끝내기 did not come back to the studio"
+            else -> null
+        }
+    }
+}
