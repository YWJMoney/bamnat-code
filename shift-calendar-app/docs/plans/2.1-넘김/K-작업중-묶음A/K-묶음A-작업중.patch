+        // 어디서 is a bank: 어디로 is a card, never the bank; cardC has no line, so the card with a line wins.
+        assertEquals(CardBillTarget.Pick(to = 11, from = 1), CardBillTarget.of(listOf(bank, cardB, cardC), 1, listOf(spent(1, 11, 3))))
+        assertEquals(CardBillTarget.Pick(to = null, from = 1), CardBillTarget.of(listOf(bank, bank2), 1, emptyList()))
+    }
+}
