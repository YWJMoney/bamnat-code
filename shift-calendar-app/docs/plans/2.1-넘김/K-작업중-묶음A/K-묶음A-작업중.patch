+
+/**
+ * 2.0.0 [RVK-62] (검토 MONEY-33) The ledger screens' logic that moves or keeps money and had no test of its own: the pay a person is
+ * offered to split into envelopes, the payments of a job kept through a screen rebuild, and the year a far goal day carries.
+ * Amounts are made up.
+ */
+class MoneyScreenLogicTest {
+    private val today = LocalDate.of(2026, 11, 10)
+    private fun income(id: Long, daysAgo: Long, amount: Long, kind: MoneyKind = MoneyKind.INCOME) =
+        MoneyEntry(id = id, date = today.minusDays(daysAgo), kind = kind, amount = amount, category = "급여")
+
+    @Test fun theLatestPayOfThreeDaysIsOfferedToSplit() {
+        val book = MoneyBook(entries = listOf(income(1, 2, 2_000_000), income(2, 1, 150_000), income(3, 5, 3_000_000)))
+        assertEquals(2L, toSplit(book, emptyList(), today)?.id)
+    }
+
+    @Test fun aSmallLineAnOldOneOrAnExpenseIsNotOffered() {
+        val book = MoneyBook(entries = listOf(income(1, 0, 49_999), income(2, 4, 2_000_000), income(3, 1, 2_000_000, MoneyKind.EXPENSE)))
+        assertNull(toSplit(book, emptyList(), today))
+    }
+
+    @Test fun payAnEnvelopeAlreadyTookAShareOfIsNotOfferedAgain() {
+        val book = MoneyBook(entries = listOf(income(1, 2, 2_000_000), income(2, 1, 1_500_000)))
+        val taken = listOf(EnvelopeMove(envelopeId = 7, date = today, amount = 100_000, entryId = 2))
+        assertEquals(1L, toSplit(book, taken, today)?.id)
+        assertNull(toSplit(MoneyBook(entries = listOf(income(2, 1, 1_500_000))), taken, today))
+    }
+
+    @Test fun aJobsPaymentsComeBackAsTheyWentIn() {
+        val list = listOf(
+            JobPayment(1, 9, LocalDate.of(2026, 10, 1), 1_000_000, "계약금"),
+            JobPayment(2, 9, LocalDate.of(2026, 10, 20), 500_000, ""),
+        )
+        assertEquals(list, decodeJobPayments(encodeJobPayments(list), 9))
+    }
+
+    @Test fun aLabelWithATabOrALineBreakCannotSplitTheNextLine() {
+        val list = listOf(JobPayment(1, 9, LocalDate.of(2026, 10, 1), 300_000, "중도금\t둘째\n줄"), JobPayment(2, 9, LocalDate.of(2026, 10, 2), 200_000, "잔금"))
+        val back = decodeJobPayments(encodeJobPayments(list), 9)
+        assertEquals(listOf(300_000L, 200_000L), back.map { it.amount })
+        assertEquals("중도금 둘째 줄", back[0].label)
+    }
+
+    @Test fun brokenLinesAndNoMoneyAreLeftOut() {
+        val text = "1\t20000\t100000\t계약금\nabc\t20000\t100\tx\n2\t20001\t0\t0원\n3\t20002\n4\t20003\t50000\t잔금"
+        assertEquals(listOf(1L, 4L), decodeJobPayments(text, 5).map { it.id })
+        assertEquals(emptyList<JobPayment>(), decodeJobPayments("", 5))
+    }
+
+    @Test fun aGoalDayOfAnotherYearCarriesItsYear() {
+        assertEquals("2027년 3월 1일", envelopeDue(LocalDate.of(2027, 3, 1), today))
