+package com.bamnat.core.money
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+import java.time.LocalDate
+
+/** 2.0.0 [RVK-62] (검토 MONEY-28·I06aa-07) 환불 받았어요 written by hand. Amounts are made up. */
+class HandRefundTest {
+    private val pay = MoneyEntry(id = 1, date = LocalDate.of(2026, 11, 3), kind = MoneyKind.EXPENSE, amount = 35_000, category = "생활", merchant = "다이소", accountId = 5, cardLast4 = "1234")
+
+    @Test fun aWholeRefundIsANegativeLineLikeThePaymentTextsCancel() {
+        val r = LedgerChecks.refundLine(pay, 35_000, LocalDate.of(2026, 11, 10), listOf(pay))!!
+        assertEquals(-35_000L, r.amount)
+        assertEquals(MoneyKind.EXPENSE, r.kind)
+        assertEquals("생활", r.category)
+        assertEquals("다이소", r.merchant)
+        assertEquals(5L, r.accountId)
+        assertEquals("1234", r.cardLast4)
+        assertEquals("결제 취소 (11/3 결제)", r.note)
+        assertEquals(LocalDate.of(2026, 11, 10), r.date)
+    }
+
+    @Test fun aPartRefundSaysWhatIsLeftAndTheNextOneTakesItOff() {
+        val first = LedgerChecks.refundLine(pay, 10_000, LocalDate.of(2026, 11, 10), listOf(pay))!!
+        assertEquals("부분취소 10,000원 (원래 35,000원, 11/3) · 남은 25,000원", first.note)
+        val book = listOf(pay, first)
+        assertEquals(25_000L, LedgerChecks.refundLeft(pay, book))
+        val second = LedgerChecks.refundLine(pay, 25_000, LocalDate.of(2026, 11, 12), book)!!
+        assertEquals("부분취소 25,000원 (원래 35,000원, 11/3) · 모두 돌려받았어요", second.note)
+        assertEquals(0L, LedgerChecks.refundLeft(pay, book + second))
+    }
+
+    @Test fun moreThanIsLeftOrNothingMakesNoLine() {
+        assertNull(LedgerChecks.refundLine(pay, 35_001, LocalDate.of(2026, 11, 10), listOf(pay)))
+        assertNull(LedgerChecks.refundLine(pay, 0, LocalDate.of(2026, 11, 10), listOf(pay)))
+        val income = pay.copy(kind = MoneyKind.INCOME)
+        assertEquals(0L, LedgerChecks.refundLeft(income, listOf(income)))
+        assertNull(LedgerChecks.refundLine(income, 1_000, LocalDate.of(2026, 11, 10), listOf(income)))
+    }
+}
