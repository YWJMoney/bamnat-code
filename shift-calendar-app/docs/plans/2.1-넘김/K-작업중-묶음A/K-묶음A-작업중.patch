@@ -0,0 +1,37 @@
+package com.bamnat.core.money
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+import java.time.LocalDate
+
+/** 2.0.0 [RVK-62] (검토 U06a-08) '어제까지 적었어요 / 3일 비었어요' is said only for a book in use and a short gap. Amounts are made up. */
+class RecordsGapTest {
+    private val today = LocalDate.of(2026, 11, 10)
+    private fun line(daysAgo: Long, source: MoneySource = MoneySource.MANUAL) =
+        MoneyEntry(date = today.minusDays(daysAgo), kind = MoneyKind.EXPENSE, amount = 5_000, category = "식비", source = source)
+    /** Ten lines by hand, the latest [daysAgo] days ago. */
+    private fun used(daysAgo: Long) = (0L until 10L).map { line(daysAgo + it) }
+
+    @Test fun saysTodayYesterdayAndTheGap() {
+        assertEquals(0, LedgerSmarts.daysSinceLine(used(0), today))
+        assertEquals(1, LedgerSmarts.daysSinceLine(used(1), today))
+        assertEquals(3, LedgerSmarts.daysSinceLine(used(3), today))
+        assertEquals(6, LedgerSmarts.daysSinceLine(used(6), today))
+    }
+
+    @Test fun aWeekOrMoreIsTheWelcomeCardsAndANewBookSaysNothing() {
+        assertEquals(null, LedgerSmarts.daysSinceLine(used(7), today))
+        assertEquals(null, LedgerSmarts.daysSinceLine(used(1).take(9), today))
+        assertEquals(null, LedgerSmarts.daysSinceLine(emptyList(), today))
+    }
+
+    @Test fun aRepeatThatPostedItselfIsNotALineWritten() {
+        assertEquals(3, LedgerSmarts.daysSinceLine(used(3) + line(0, MoneySource.FIXED), today))
+        // A line that came in by itself (payment text) counts: the book is up to date.
+        assertEquals(0, LedgerSmarts.daysSinceLine(used(3) + line(0, MoneySource.NOTIFICATION), today))
+    }
+
+    @Test fun aLineDatedAfterTodayIsNotCounted() {
+        assertEquals(3, LedgerSmarts.daysSinceLine(used(3) + line(-2), today))
+    }
+}
diff --git a/shift-calendar-app/core/src/test/kotlin/com/bamnat/core/money/RiskyMathTest.kt b/shift-calendar-app/core/src/test/kotlin/com/bamnat/core/money/RiskyMathTest.kt
new file mode 100644
index 000000000..90ecc2602
--- /dev/null
+++ b/shift-calendar-app/core/src/test/kotlin/com/bamnat/core/money/RiskyMathTest.kt
@@ -0,0 +1,84 @@
+package com.bamnat.core.money
+
+import com.bamnat.core.invest.FillMath
+import com.bamnat.core.invest.Market
+import com.bamnat.core.work.WorkStyle
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.time.YearMonth
+
+/**
+ * 2.0.0 [RVK-62] (검토 MONEY-80) Money arithmetic that had no test under its own name: the year across calendars with its shares and
+ * income types (the 5월 신고 talk), and the sums behind a read-in fill (수량 × 단가 ≈ 금액) that decide whether a line goes in without a
+ * question. Amounts are made up.
+ */
+class RiskyMathTest {
+    private fun month(calendar: String, name: String, m: Int, income: Long, spent: Long = 0, days: Int = 0) = CalendarMonth(
+        calendar, name,
+        MonthMoney(YearMonth.of(2026, m), payEstimate = null, payRecorded = income, jobEarned = 0, jobReceived = 0, jobCount = 0, sales = 0,
+            salesCosts = 0, salesDays = 0, otherIncome = 0, expenses = spent, expenseByCategory = emptyList()), workDays = days)
+
+    @Test fun theYearAddsEachCalendarOnceAndSharesOutOfTheWhole() {
+        val year = AllCalendarsYear(2026, listOf(
+            AllCalendarsMonth(listOf(month("a", "병원", 1, 3_000_000, days = 20), month("b", "배달", 1, 1_000_000, days = 8))),
+            AllCalendarsMonth(listOf(month("a", "병원", 2, 3_000_000, days = 19), month("b", "배달", 2, 0))),
+        ))
+        assertEquals(listOf("a" to 6_000_000L, "b" to 1_000_000L), year.rows.map { it.calendar to it.income })
+        assertEquals(39, year.rows.first().workDays)
+        assertEquals(7_000_000L, year.income)
+        assertEquals(85, year.share(year.rows[0]))
+        assertEquals(14, year.share(year.rows[1]))
+        assertTrue(year.manyJobs)
+    }
+
+    @Test fun oneCalendarOrAnEmptyYearIsNotManyJobsAndSharesNothing() {
+        val one = AllCalendarsYear(2026, listOf(AllCalendarsMonth(listOf(month("a", "병원", 1, 2_000_000), month("b", "배달", 1, 0)))))
+        assertFalse(one.manyJobs)
+        val none = AllCalendarsYear(2026, emptyList())
+        assertEquals(0, none.share(AllCalendarsYear.Row("a", "병원", 0, 0)))
+        assertEquals(emptyList<AllCalendarsYear.Row>(), none.rows)
+    }
+
+    @Test fun incomeIsGroupedByTypeLargestFirstWithoutTheUntyped() {
+        val year = AllCalendarsYear(2026, listOf(AllCalendarsMonth(listOf(
+            month("a", "병원", 1, 3_000_000), month("b", "배달", 1, 1_000_000), month("c", "강연", 1, 500_000), month("d", "주식", 1, 900_000)))))
+        val by = year.byType { id -> mapOf("a" to IncomeType.WAGE, "b" to IncomeType.BUSINESS, "c" to IncomeType.BUSINESS, "d" to null)[id] }
+        assertEquals(listOf(IncomeType.WAGE to 3_000_000L, IncomeType.BUSINESS to 1_500_000L), by)
+    }
+
+    @Test fun theKindOfWorkGivesTheFirstGuessOfHowIncomeIsTaxed() {
+        assertEquals(IncomeType.WAGE, IncomeType.guess(WorkStyle.SHIFT))
+        assertEquals(IncomeType.WAGE, IncomeType.guess(null))
+        assertEquals(IncomeType.BUSINESS, IncomeType.guess(WorkStyle.BUSINESS))
+        assertEquals(IncomeType.BUSINESS, IncomeType.guess(WorkStyle.FIELD))
+        assertEquals(IncomeType.DAILY, IncomeType.guess(WorkStyle.FIELD, FieldRules(mode = FieldMode.DAY_RATE)))
+        assertNull(IncomeType.guess(WorkStyle.INVEST))
+        assertEquals(IncomeType.OTHER, IncomeType.of("OTHER"))
+        assertNull(IncomeType.of("nope"))
+    }
+
+    @Test fun aPriceWorkedFromAnAmountKeepsWholeWonAndFourPlacesOtherwise() {
+        assertEquals(71_500.0, FillMath.round(71_500.0004), 0.0)
+        assertEquals(12.3457, FillMath.round(12.345678), 0.0)
+        assertEquals(10.0, FillMath.round(9.9996), 0.0)
+    }
+
+    @Test fun quantityTimesPriceMustAgreeWithTheAmountWithinRounding() {
+        assertTrue(FillMath.agrees(10.0, 71_500.0, 715_000.0))
+        assertTrue(FillMath.agrees(10.0, 71_500.0, 715_900.0))   // under 0.2% and under a won a share is a rounding
+        assertFalse(FillMath.agrees(10.0, 71_500.0, 725_000.0))  // a digit misread
+        assertFalse(FillMath.agrees(0.0, 71_500.0, 715_000.0))
+        assertFalse(FillMath.agrees(10.0, 0.0, 715_000.0))
+    }
+
+    @Test fun whatGoesInWithoutAQuestionAgreesToTheLastWonOrCent() {
+        assertTrue(FillMath.exact(10.0, 71_500.0, 715_005.0, Market.KR_STOCK))
+        assertFalse(FillMath.exact(10.0, 71_500.0, 715_100.0, Market.KR_STOCK))
+        assertTrue(FillMath.exact(3.0, 150.25, 450.76, Market.US_STOCK))
+        assertFalse(FillMath.exact(3.0, 150.25, 451.5, Market.US_STOCK))
+        assertFalse(FillMath.exact(0.0, 150.25, 450.76, Market.US_STOCK))
+    }
+}
