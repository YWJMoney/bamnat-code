+/**
+ * 2.0.0 [RVK-62] (검토 MONEY-08, 1.37 MED-1) Where a 카드값 transfer goes by itself, so the money does not just leave and the net worth
+ * is right. It was in the entry sheet; here it can be tested. [from] is the 어디서 the sheet shows now.
+ * - 어디서 is a credit card (the last account used): that card is 어디로, and 어디서 becomes the card's pay-from account, else the bank
+ *   most used.
+ * - else 어디로 is the credit card spent on last (not the one used most), apart from 어디서.
+ * Null parts stay as they were.
+ */
+object CardBillTarget {
+    data class Pick(val to: Long?, val from: Long?)
+
+    fun of(accounts: List<MoneyAccount>, from: Long?, entries: List<MoneyEntry>): Pick {
+        val credit = AccountType.CREDIT
+        val source = accounts.firstOrNull { it.id == from }
+        if (source?.type == credit) {
+            val bank = source.payFromId ?: accounts.filter { it.type != credit && it.type != AccountType.CHECK }
+                .maxByOrNull { a -> entries.count { it.accountId == a.id } }?.id
+            return Pick(to = source.id, from = bank)
+        }
+        val lastSpent = accounts.filter { it.id != from && it.type == credit }
+            .maxByOrNull { a -> entries.filter { it.accountId == a.id && it.kind == MoneyKind.EXPENSE }
+                .maxOfOrNull { it.date.toEpochDay() * 1_000_000_000L + it.id } ?: Long.MIN_VALUE }?.id
+        return Pick(to = lastSpent, from = from)
+    }
+}
